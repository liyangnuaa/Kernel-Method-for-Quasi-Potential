@article{yannis_unicorn,
    author = {Junge, Oliver and Kevrekidis, Ioannis G.},
    title = "{On the sighting of unicorns: A variational approach to computing invariant sets in dynamical systems}",
    journal = {Chaos: An Interdisciplinary Journal of Nonlinear Science},
    volume = {27},
    number = {6},
    pages = {063102},
    year = {2017},
    month = {06},
    abstract = "{We propose to compute approximations to invariant sets in dynamical systems by minimizing an appropriate distance between a suitably selected finite set of points and its image under the dynamics. We demonstrate, through computational experiments, that this approach can successfully converge to approximations of (maximal) invariant sets of arbitrary topology, dimension, and stability, such as, e.g., saddle type invariant sets with complicated dynamics. We further propose to extend this approach by adding a Lennard-Jones type potential term to the objective function, which yields more evenly distributed approximating finite point sets, and illustrate the procedure through corresponding numerical experiments.}",
    issn = {1054-1500},
    doi = {10.1063/1.4983468},
    url = {https://doi.org/10.1063/1.4983468},
    eprint = {https://pubs.aip.org/aip/cha/article-pdf/doi/10.1063/1.4983468/14612274/063102\_1\_online.pdf},
}

