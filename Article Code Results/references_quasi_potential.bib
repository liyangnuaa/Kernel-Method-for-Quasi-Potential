@article{PAZOUKI2011575,
title = "Bases for kernel-based spaces",
journal = "Journal of Computational and Applied Mathematics",
volume = "236",
number = "4",
pages = "575 - 588",
year = "2011",
note = "International Workshop on Multivariate Approximation and Interpolation with Applications (MAIA 2010)",
issn = "0377-0427",
doi = "https://doi.org/10.1016/j.cam.2011.05.021",
url = "http://www.sciencedirect.com/science/article/pii/S0377042711002688",
author = "Maryam Pazouki and Robert Schaback",
keywords = "Scattered data, Kernels, Matching pursuit, Adaptivity, Stability, Duality",
abstract = "Since it is well-known (De Marchi and Schaback (2001) [4]) that standard bases of kernel translates are badly conditioned while the interpolation itself is not unstable in function space, this paper surveys the choices of other bases. All data-dependent bases turn out to be defined via a factorization of the kernel matrix defined by these data, and a discussion of various matrix factorizations (e.g. Cholesky, QR, SVD) provides a variety of different bases with different properties. Special attention is given to duality, stability, orthogonality, adaptivity, and computational efficiency. The √¢¬Ä¬úNewton√¢¬Ä¬ù basis arising from a pivoted Cholesky factorization turns out to be stable and computationally cheap while being orthonormal in the √¢¬Ä¬únative√¢¬Ä¬ù Hilbert space of the kernel. Efficient adaptive algorithms for calculating the Newton basis along the lines of orthogonal matching pursuit conclude the paper."
}

